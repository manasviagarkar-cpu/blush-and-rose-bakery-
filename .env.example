# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/blushrose?schema=public"

# Admin Authentication
ADMIN_EMAIL="admin@blushrose.com"
ADMIN_SEED_PASSWORD="strong_initial_admin_password_here"
ADMIN_SESSION_SECRET="replace_with_a_secure_random_32_char_secret_key_minimum"

# Payment Gateway (Razorpay)
# Mode: "test" or "live"
PAYMENT_MODE="test"
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
